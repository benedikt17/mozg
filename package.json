{
  "name": "hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:markdown": "vitest run tests/markdown-roundtrip",
    "test:rls": "vitest run tests/rls",
    "supabase": "supabase"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.0",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.110.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.10",
    "prettier": "3.9.4",
    "prettier-plugin-tailwindcss": "0.8.0",
    "supabase": "2.109.1",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  }
}
