# Enable only for local development. Production ignores this bypass even when set.
# Local mode uses IndexedDB and bypasses Supabase Auth.
MOZG_LOCAL_DEV_MODE=false

# Public values may be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
# Used only by the server-only local development session bootstrap.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
MOZG_LOCAL_DEV_USER_EMAIL=mozg-local-development@example.test
MOZG_LOCAL_DEV_USER_PASSWORD=replace-with-local-development-password
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=replace-with-local-google-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=replace-with-local-google-secret

# Server-only automatic Knowledge backup. Never expose these as NEXT_PUBLIC_* values.
# Use a dedicated Supabase sb_secret_ key for this worker rather than the browser key.
SUPABASE_BACKUP_SECRET_KEY=sb_secret_replace-with-dedicated-backup-key
MOZG_BACKUP_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
TELEGRAM_BACKUP_BOT_TOKEN=000000000:replace-with-telegram-bot-token
TELEGRAM_BACKUP_CHAT_ID=-1000000000000
# Vercel Cron sends this value as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=replace-with-long-random-cron-secret
