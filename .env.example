# Enable only for local development. Production ignores this bypass even when set.
# Local mode uses IndexedDB and bypasses Supabase Auth.
MOZG_LOCAL_DEV_MODE=false

# Public values may be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
# Used only by the server-only local development session bootstrap.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
MOZG_LOCAL_DEV_USER_EMAIL=mozg-local-development@example.test
MOZG_LOCAL_DEV_USER_PASSWORD=replace-with-local-development-password
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=replace-with-local-google-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=replace-with-local-google-client-secret
